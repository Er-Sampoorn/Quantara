# QUANTARA Environment Configuration
# ==================================

# Database Connection (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql://quantara:quantara_secure_password@localhost:5432/quantara_db

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
JWT_SECRET=quantara-super-secret-jwt-key-2026
ENCRYPTION_KEY=quantara-default-secure-32-byte-key-2026

# Live Trading Safety Gate (Default: false)
ENABLE_LIVE_TRADING=false

# Optional External Provider API Keys (Pluggable Providers)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
OPENAI_API_KEY=

# Next.js Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
